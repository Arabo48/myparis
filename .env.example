# Copy this file to .env and fill in your own Supabase project values.
# Get these from: Supabase Dashboard > Project Settings > API
# NEVER commit the real .env file or the service_role key anywhere in
# frontend code — only the anon/public key belongs in the browser.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# Used only by server-side/admin scripts (seed data, etc.) — never
# reference this from any file under /assets or /pages.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
